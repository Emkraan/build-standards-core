{
  "name": "@build-standards/opscenter-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.app.json",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint",
    "build": "tsc -p tsconfig.app.json && vite build && npm run --silent check:bundle-size",
    "check": "npm run typecheck && npm run test && npm run build",
    "check:bundle-size": "node tools/check-bundle-size.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "4.14.0",
    "oxlint": "^1.75.0",
    "playwright-core": "1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "description": "The ops center app: React, TypeScript and Vite on the shared kit (opscenter/DESIGN.md section 4).",
  "engines": {
    "node": ">=22.22"
  }
}
