#!/bin/sh
# Runs the core checks before every commit, including any private denylist kept outside the repo.
# Enable once per clone: git config core.hooksPath checks/hooks
set -e
python3 checks/check-sanitised.py >/dev/null || { python3 checks/check-sanitised.py | grep -v '^check-'; echo "pre-commit: sanitisation failed"; exit 1; }
python3 checks/check-ascii.py >/dev/null || { python3 checks/check-ascii.py; exit 1; }
python3 checks/check-links.py >/dev/null || { python3 checks/check-links.py; exit 1; }
email=$(git config user.email || true)
case "$email" in
  *@users.noreply.github.com) ;;
  *) echo "pre-commit: git user.email is not a GitHub noreply address. Run: git config user.email <id>+<login>@users.noreply.github.com"; exit 1 ;;
esac
